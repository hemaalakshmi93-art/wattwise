# Copy to .env and adjust. Never commit real secrets.

# SQLite file location (default: backend/instance/wattwise.db)
# WATTWISE_DB=

# Grid emission factor in kg CO2e per kWh. Check the latest official CEA value.
WATTWISE_EMISSION_FACTOR=0.82

# kg CO2e per km for the optional transport input (assumed average petrol car)
WATTWISE_TRANSPORT_FACTOR=0.17

# Rule-of-thumb kWh per person per month used by the recommendation engine
WATTWISE_PER_PERSON_THRESHOLD=100

# Frontend origin allowed to call the API
WATTWISE_CORS_ORIGIN=http://localhost:5173

# Optional AI Energy Coach (Adaption Labs). Leave empty until the API is confirmed.
ADAPTION_API_URL=
ADAPTION_API_KEY=
